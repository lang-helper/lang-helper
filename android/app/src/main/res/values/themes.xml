<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      普通的全屏窗口（悬浮球 / 小窗打开也正常），底色和网页一样，加载时不闪白。
    -->
    <style name="Theme.Sheet" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sheet_bg</item>
        <item name="android:statusBarColor">@color/sheet_bg</item>
        <item name="android:navigationBarColor">@color/sheet_bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
