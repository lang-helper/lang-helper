<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup=false：API key 存在 App 里，不让它跟着系统备份走 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Sheet">

        <!--
          一个全屏窗口（小窗里也能用，改变小窗大小时不会重新加载），两个入口：
          1) 桌面图标 / 悬浮球（空的输入框）
          2) 选中文字 → 菜单里的「lang-helper」（PROCESS_TEXT；部分手机的菜单里不显示）。能改的输入框里还会显示「替换」。
        -->
        <activity
            android:name=".SheetActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="@string/menu_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          「维基速查」：桌面上单独一个图标（taskAffinity 不同，最近任务里也是单独一项），打开 wiki.html。
          选中文字 → 菜单里的「查维基」也进这里。
        -->
        <activity
            android:name=".WikiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:icon="@mipmap/ic_wiki"
            android:label="@string/wiki_name"
            android:resizeableActivity="true"
            android:roundIcon="@mipmap/ic_wiki"
            android:taskAffinity="app.langhelper.wiki"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:label="@string/wiki_menu_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
